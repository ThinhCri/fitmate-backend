# Fitmate Backend (.NET 8) — Environment variables
# CHỈ chứa tên biến + placeholder. KHÔNG commit giá trị thật.
# Copy thành `.env` cho local, điền giá trị thật. .env đã có trong .gitignore.

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ===== Database (PostgreSQL self-hosted) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitmate
DB_USER=fitmate
DB_PASSWORD=__SET_LOCAL_PASSWORD__
DB_SSLMODE=prefer

# Connection string build sẵn (alternative):
# DATABASE_URL=Host=postgres;Port=5432;Database=fitmate;Username=fitmate;Password=__SET_LOCAL_PASSWORD__

# ===== Auth =====
# JWT signing key. Generate: `openssl rand -base64 64`.
# Min 32 bytes cho HS256. Dùng HS512 với 64+ bytes.
JWT_SIGNING_KEY=__SET_64_BYTES_BASE64__
JWT_ISSUER=fitmate-api
JWT_AUDIENCE=fitmate-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Bootstrap admin (chỉ dùng cho CLI create-admin)
BOOTSTRAP_ADMIN_EMAIL=admin@fitmate.vn
# Password KHÔNG đặt ở đây; CLI đọc từ stdin.

# ===== Email (SMTP) =====
# Local MailHog defaults. For Brevo use smtp-relay.brevo.com:587 + StartTls.
Email__SmtpHost=mailhog
Email__SmtpPort=1025
Email__TlsMode=None
Email__SmtpUsername=
Email__SmtpPassword=
Email__SenderEmail=noreply@fitmate.local
Email__SenderName=Fitmate
Email__FrontendBaseUrl=http://localhost:8081

# ===== PT phone verification: SpeedSMS =====
# Keep disabled until the operator has an access token and has tested delivery to a real phone.
# The default SMS type 4 uses the provider's shared transactional sender; type 3 needs an approved Sender.
Sms__Provider=None
Sms__AccessToken=
Sms__SmsType=4
Sms__Sender=

# ===== PT online sessions: Google Meet OAuth =====
# Redirect URI must match the Google Cloud OAuth client's authorized redirect URI exactly.
# Browser-on-PC local example: http://localhost:5116/api/v1/integrations/google-meet/callback
# A physical phone needs a public HTTPS callback routed to this backend; localhost points to the phone.
GoogleMeet__ClientId=
GoogleMeet__ClientSecret=
GoogleMeet__RedirectUri=

# ===== Payment: payOS (disabled until operator approval and verification) =====
Payment__Provider=payos
Payment__AllowMockProvider=false
Payos__Enabled=false
Payos__MerchantApproved=false
Payos__ClientId=__SET_PAYOS_CLIENT_ID__
Payos__ApiKey=__SET_PAYOS_API_KEY__
Payos__ChecksumKey=__SET_PAYOS_CHECKSUM_KEY__
Payos__AccountNumber=__SET_PAYOS_ACCOUNT_NUMBER__
Payos__ReturnUrl=https://__SET_PUBLIC_HOST__/api/v1/payments/payos/return
Payos__CancelUrl=https://__SET_PUBLIC_HOST__/api/v1/payments/payos/cancel

# Legacy VNPay configuration; not selected when Payment__Provider=payos.
VNPAY_TMN_CODE=__SET_VNPAY_TMN__
VNPAY_HASH_SECRET=__SET_VNPAY_HASH_SECRET__
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://api.fitmate.vn/api/v1/payments/vnpay/ipn
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ===== CORS =====
# Comma-separated. Production: https://admin.fitmate.vn
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# ===== Rate limiting =====
RATE_LIMIT_PER_MINUTE_PER_IP=60
RATE_LIMIT_AUTH_PER_MINUTE_PER_IP=5

# ===== Logging =====
LOG_LEVEL=Information
SERILOG_MIN_LEVEL=Information

# ===== Feature flags =====
FEATURE_AI_ENABLED=true
FEATURE_PAYMENT_ENABLED=false
FEATURE_PUSH_ENABLED=false

# ===== PT bank-account verification (server-side secrets) =====
# Disabled fails closed. Set VietQr only after obtaining Lookup API credentials.
BankLookup__Provider=Disabled
BankLookup__BaseUrl=https://api.vietqr.io
BankLookup__ClientId=
BankLookup__ApiKey=

# ===== Platform policy (DEC-029 read-only) =====
# Phí nền tảng lưu theo basis points. 1000 bps = 10.00% (mặc định MVP).
# Override env PLATFORM_POLICY__FEEBPS=... nếu cần test.
# Release đầu KHÔNG có endpoint POST để sửa — chỉ đọc từ config.
PLATFORM_POLICY__FEEBPS=1000
PLATFORM_POLICY__POLICYVERSION=v1
PLATFORM_POLICY__EFFECTIVEFROMUTC=2026-09-19T00:00:00Z

# ===== Storage =====
# Use r2 on every environment that should read the existing R2 exercise library.
# Compose must interpolate this value; never hardcode local over the selected provider.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fitmate-media
SIGNED_URL_TTL_SECONDS=900

# ===== Real AI adapters (Gemini hosted scan or optional Python service) =====
Ai__Enabled=false
Ai__FoodScanEnabled=false
Ai__CompanionChatEnabled=false
Ai__WorkoutAdjustEnabled=false
Ai__Provider=none
Ai__CompanionProvider=none
# Docker profile `ai`: http://food-ai:8000. Python chạy trên host: http://host.docker.internal:8000.
Ai__BaseUrl=http://food-ai:8000
# Required for python_service. Use the same private value on Backend and the AI sidecar.
Ai__InternalToken=
Ai__TimeoutSeconds=60
Ai__MaxImageSizeBytes=10485760

# Enable usage enforcement when enabling AI; Play sales remain a separate verified release gate.
AiUsage__Enabled=false
AiUsage__FreeChatPerDay=10
AiUsage__FreeScansPerDay=0
AiUsage__PlusChatPerDay=100
AiUsage__PlusScansPerDay=0
GooglePlayBilling__Enabled=false
# Independent checkout switch. Turn off to stop new sales while keeping verification for paid users.
GooglePlayBilling__SalesEnabled=false
GooglePlayBilling__OneTimeSalesEnabled=false
GooglePlayBilling__OneTimeProductId=fitmate_ai_plus_month
GooglePlayBilling__OneTimeMinimumAndroidVersionCode=8
GooglePlayBilling__PackageName=vn.fitmate.app
GooglePlayBilling__ProductId=fitmate_ai_plus
GooglePlayBilling__BasePlanId=monthly
# Base64 service-account JSON granted Android Publisher access in Play Console. Secret: local .env / secret manager only.
GooglePlayBilling__ServiceAccountJsonBase64=
GooglePlayBilling__MinimumAndroidVersionCode=5
GooglePlayBilling__RefreshMinutes=5

# ===== Google Analytics 4 read-only Admin report =====
# Empty pair returns configured=false; a half-configured or invalid provider fails closed.
# Numeric GA4 Property ID (not Measurement ID). Do not put the service-account JSON in mobile/web.
Ga4__PropertyId=
Ga4__LandingStreamId=
# Base64 service-account JSON with GA4 Viewer access and Analytics Data API enabled.
Ga4__ServiceAccountJsonBase64=

# ===== Gemini food scan and image/text chat (server-side secret) =====
Gemini__Enabled=false
Gemini__ApiKey=
Gemini__Model=gemini-3.8-flash
Gemini__TimeoutSeconds=60
Gemini__MaxOutputTokens=1000
Gemini__MaxHistoryMessages=20

# ===== Groq companion chat (free testing; server-side secret) =====
Groq__Enabled=false
Groq__ApiKey=
Groq__Model=qwen/qwen3.8-27b
Groq__TimeoutSeconds=60
Groq__MaxOutputTokens=500
Groq__MaxHistoryMessages=10

# ===== Android FCM push: only this env-backed switch controls sending =====
# Same Firebase project as Android google-services.json. Backend-only service account.
FcmPush__Enabled=false
FcmPush__ProjectId=
FcmPush__ServiceAccountJsonBase64=
