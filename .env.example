# Fitmate Backend (.NET 8) — Environment variables
# CHỈ chứa tên biến + placeholder. KHÔNG commit giá trị thật.
# Copy thành `.env` cho local, điền giá trị thật. .env đã có trong .gitignore.

# ===== ASP.NET Core =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# ===== Database (PostgreSQL self-hosted) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitmate
DB_USER=fitmate
DB_PASSWORD=__SET_LOCAL_PASSWORD__
DB_SSLMODE=prefer

# Connection string build sẵn (alternative):
# DATABASE_URL=Host=postgres;Port=5432;Database=fitmate;Username=fitmate;Password=__SET_LOCAL_PASSWORD__

# ===== Auth =====
# JWT signing key. Generate: `openssl rand -base64 64`.
# Min 32 bytes cho HS256. Dùng HS512 với 64+ bytes.
JWT_SIGNING_KEY=__SET_64_BYTES_BASE64__
JWT_ISSUER=fitmate-api
JWT_AUDIENCE=fitmate-clients
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Bootstrap admin (chỉ dùng cho CLI create-admin)
BOOTSTRAP_ADMIN_EMAIL=admin@fitmate.vn
# Password KHÔNG đặt ở đây; CLI đọc từ stdin.

# ===== Email (SMTP) =====
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=__SET_SMTP_PASSWORD__
SMTP_FROM=noreply@fitmate.vn
SMTP_FROM_NAME=Fitmate
SMTP_USE_SSL=false

# ===== Payment (VNPay) — giai đoạn 2 =====
VNPAY_TMN_CODE=__SET_VNPAY_TMN__
VNPAY_HASH_SECRET=__SET_VNPAY_HASH_SECRET__
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=https://api.fitmate.vn/api/v1/payments/vnpay/ipn
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# ===== CORS =====
# Comma-separated. Production: https://admin.fitmate.vn
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ===== Rate limiting =====
RATE_LIMIT_PER_MINUTE_PER_IP=60
RATE_LIMIT_AUTH_PER_MINUTE_PER_IP=5

# ===== Logging =====
LOG_LEVEL=Information
SERILOG_MIN_LEVEL=Information

# ===== Feature flags =====
FEATURE_AI_ENABLED=true
FEATURE_PAYMENT_ENABLED=true
FEATURE_PUSH_ENABLED=false

# ===== Platform policy (DEC-029 read-only) =====
# Phí nền tảng lưu theo basis points. 1000 bps = 10.00% (mặc định MVP).
# Override env PLATFORM_POLICY__FEEBPS=... nếu cần test.
# Release đầu KHÔNG có endpoint POST để sửa — chỉ đọc từ config.
PLATFORM_POLICY__FEEBPS=1000
PLATFORM_POLICY__POLICYVERSION=v1
PLATFORM_POLICY__EFFECTIVEFROMUTC=2026-09-19T00:00:00Z

# ===== Storage =====
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/files
SIGNED_URL_TTL_SECONDS=900

# ===== AI adapter =====
AI_PROVIDER=stub
AI_STUB_LATENCY_MS=200
AI_TIMEOUT_MS=8000
