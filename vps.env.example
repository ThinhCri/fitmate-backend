# Copy to /home/fitmate/backend/.env on the VPS; never commit the filled file.
# Generate each secret independently. Do not reuse development credentials.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

DB_NAME=fitmate
DB_USER=fitmate
DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

CORS_ALLOWED_ORIGINS=https://admin.fitmate.site
# Set FORWARDED_KNOWN_PROXIES to the exact Docker gateway after network creation.
# Do not trust the entire Docker private-address range.

# Production requires a working TLS SMTP service for account verification/reset.
Email__SmtpHost=REPLACE_WITH_SMTP_HOST
Email__SmtpPort=587
Email__TlsMode=StartTls
Email__SmtpUsername=REPLACE_WITH_SMTP_USERNAME
Email__SmtpPassword=REPLACE_WITH_SMTP_PASSWORD
Email__SenderEmail=REPLACE_WITH_VERIFIED_SENDER_EMAIL
Email__SenderName=Fitmate
Email__FrontendBaseUrl=https://admin.fitmate.site

STORAGE_PUBLIC_BASE_URL=https://api.fitmate.site/uploads
Storage__SignedUrlSecret=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Bootstrap only. Enable live services after their own configuration and UAT.
FEATURE_PAYMENT_ENABLED=false
Payos__Enabled=false
Payment__AllowMockProvider=false
FEATURE_AI_ENABLED=false
Ai__Enabled=false
Ai__FoodScanEnabled=false
FEATURE_PUSH_ENABLED=false
GooglePlayBilling__Enabled=false
GooglePlayBilling__SalesEnabled=false
Sms__Provider=None
# Keep disabled until the account-deletion PostgreSQL/storage checks and
# restore/tombstone procedure have been accepted for this environment.
AccountDeletion__FinalizerEnabled=false
