# ===== Stage 1: Build EF migrations bundle =====
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Pin dotnet-ef to match EF Core runtime version (8.0.10 in Fitmate.Infrastructure.csproj).
ENV DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
RUN dotnet tool install --global dotnet-ef --version 8.0.10
ENV PATH="$PATH:/root/.dotnet/tools"

# Source-only restore (no solution COPY). Tests dir is excluded by .dockerignore so not copied.
COPY src/Fitmate.Domain/Fitmate.Domain.csproj src/Fitmate.Domain/
COPY src/Fitmate.Application/Fitmate.Application.csproj src/Fitmate.Application/
COPY src/Fitmate.Infrastructure/Fitmate.Infrastructure.csproj src/Fitmate.Infrastructure/
COPY src/Fitmate.Api/Fitmate.Api.csproj src/Fitmate.Api/
RUN dotnet restore src/Fitmate.Api/Fitmate.Api.csproj

COPY src/ src/

# Build self-contained bundle targeting Linux glibc (Debian-slim base) so the runtime image needs no .NET runtime.
RUN dotnet ef migrations bundle \
    --self-contained \
    --runtime linux-x64 \
    --project src/Fitmate.Infrastructure \
    --startup-project src/Fitmate.Api \
    --output /out/efbundle \
    --verbose

# ===== Stage 2: Runtime — debian-slim runtime-deps only =====
FROM mcr.microsoft.com/dotnet/runtime-deps:8.0-bookworm-slim AS runtime
WORKDIR /app

# Non-root user matching api image UID for parity. Use /tmp for HOME and bundle extract dir.
RUN groupadd --gid 1001 --system fitmate \
    && useradd --uid 1001 --system --gid fitmate --create-home --home-dir /tmp fitmate \
    && mkdir -p /tmp/bundle-extract \
    && chown -R fitmate:fitmate /tmp/bundle-extract
# runtime-deps image already ships minimal apt cache; no extra packages required.

COPY --from=build --chown=fitmate:fitmate /out/efbundle /app/efbundle
RUN chmod +x /app/efbundle

USER fitmate
ENV DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_BUNDLE_EXTRACT_BASE_DIR=/tmp/bundle-extract

# No EXPOSE/HEALTHCHECK — one-shot job. Compose uses `run --rm`.
ENTRYPOINT ["/app/efbundle"]
